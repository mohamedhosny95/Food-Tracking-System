# Telegram — get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Google Gemini — FREE, get from aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Notion — get from notion.so/my-integrations
NOTION_API_KEY=
# These are filled in automatically by setup_notion.py / migrate_notion.py
NOTION_FOOD_DB_ID=
NOTION_DAILY_DB_ID=
NOTION_RESTAURANTS_DB_ID=
NOTION_SAVED_MEALS_DB_ID=
NOTION_PARENT_PAGE_ID=

# Legacy fallback goals. The supplied plan profiles in nutrition_profiles.py are
# used by default and can be edited in Telegram with /goals.
DAILY_CALORIES_GOAL=2000
DAILY_PROTEIN_GOAL=150
DAILY_CARBS_GOAL=250
DAILY_FAT_GOAL=65
DAILY_FIBER_GOAL=30
DAILY_WATER_GOAL_ML=2500

# Required: the single owner's Telegram user ID from @userinfobot.
# The bot fails closed unless exactly one ID is configured.
ALLOWED_USER_IDS=
ALLOW_UNAUTHENTICATED=false

TIMEZONE_NAME=Africa/Cairo

# Webhook mode only. Do not reuse TELEGRAM_BOT_TOKEN for either value.
WEBHOOK_DOMAIN=
WEBHOOK_PATH=
WEBHOOK_SECRET_TOKEN=
